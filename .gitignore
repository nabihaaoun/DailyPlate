# ==============================================================================
# DailyPlate - Comprehensive .gitignore
# Expo (SDK 57) + React Native + Redux Toolkit + SQLite + Vitest
# ==============================================================================

# 1. Package Dependencies
node_modules/
.pnp
.pnp.js

# 2. Expo, Metro & EAS Build Artifacts
.expo/
dist/
web-build/
.eas/
expo-env.d.ts
.metro-health-check*

# 3. Generated Native Platforms & Continuous Native Generation (CNG)
/ios/
/android/
Pods/
*.apk
*.aab
*.ipa

# 4. Native Signing, Certificates & Keystores
*.orig.*
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.pem

# 5. SQLite & Local Database Artifacts
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 6. Environment Variables & Private Secrets
.env
.env.*
.env*.local
!.env.example

# 7. Testing, Coverage & Diagnostics
coverage/
*.lcov
.nyc_output/
.vitest/

# 8. Compilers, Linters & Build Caches
*.tsbuildinfo
.eslintcache
.cache/
.turbo/
.parcel-cache/

# 9. Logs & Package Manager Debug Outputs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# 10. Graphify & Local AI Assistant Artifacts
graphify-out/
.graphify/
graph.html
GRAPH_REPORT.md
.claude/
.cursor/
.gemini/

# 11. IDE & Editor Artifacts
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# 12. macOS & Windows System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# 13. Temporary & Scratch Files
*.tmp
*.temp
example
node_modules
